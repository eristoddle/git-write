# Multi-stage build for production
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# First, build the SDK
WORKDIR /app/gitwrite_sdk
COPY gitwrite_sdk/package*.json ./
RUN npm ci
COPY gitwrite_sdk/ ./
RUN npm run build

# Now build the web app
WORKDIR /app/gitwrite-web
COPY gitwrite-web/package*.json ./

# Install dependencies (including dev dependencies for build)
RUN npm ci

# Copy source code
COPY gitwrite-web/ .

# Build the application
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy custom nginx configuration
COPY gitwrite-web/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built application from builder stage
COPY --from=builder /app/gitwrite-web/dist /usr/share/nginx/html

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Expose port 80
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]