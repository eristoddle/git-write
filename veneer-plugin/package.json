{
  "name": "gitwrite-veneer-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "GitWrite for Veneer: save versions, browse and restore them, and compare, on plain git.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=neutral --outfile=main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@veneer/api": "github:eristoddle/veneer-api#v0.40.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
